{
  "name": "crabcode-tui",
  "version": "1.0.37",
  "private": true,
  "description": "Open-source CrabCode native terminal UI and its direct backend runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acosmi/CrabCode-TUI.git"
  },
  "bugs": "https://github.com/acosmi/CrabCode-TUI/issues",
  "homepage": "https://github.com/acosmi/CrabCode-TUI#readme",
  "scripts": {
    "build": "bun run build:ts && bun run build:rust && bun run build:memory && bun run build:account-bridge",
    "build:ts": "bun scripts/build-ts.ts",
    "build:rust": "cargo build --manifest-path crates/Cargo.toml --workspace",
    "build:memory": "cargo build --manifest-path libs/acosmi-memory/Cargo.toml --bin acosmi-memory-orchestrator",
    "build:account-bridge": "bun scripts/build-account-bridge.ts",
    "release:assemble": "bun scripts/assemble-release.mjs",
    "test": "bun scripts/run-full-test-suite.ts ./tests",
    "test:unit": "bun scripts/run-full-test-suite.ts ./tests/unit",
    "test:integration": "bun scripts/run-full-test-suite.ts ./tests/integration",
    "test:rust": "cargo test --locked --manifest-path crates/Cargo.toml --workspace && cargo test --locked --manifest-path crates/Cargo.toml -p crabcode-tui --features terminal-lifecycle-tests --test terminal_lifecycle",
    "test:memory": "cargo test --locked --manifest-path libs/acosmi-memory/Cargo.toml --workspace",
    "test:search": "cargo test --locked --manifest-path libs/acosmi-se/Cargo.toml --workspace",
    "test:account-bridge": "go test -C components/oauthapi-llm ./...",
    "smoke:tui": "bun run build:ts && bun run check:tui-runtime-binding && bun scripts/tui-runtime-smoke.mjs",
    "smoke:package": "bun scripts/release-package-smoke.mjs",
    "typecheck": "tsc -p tsconfig.tui-runtime.json --noEmit",
    "check:capabilities": "bun scripts/generate-renderer-capability-contract.mjs --check",
    "check:tui-runtime-binding": "bun scripts/verify-tui-runtime-source-binding.mjs",
    "check:tui-command-capabilities": "bun scripts/verify-direct-tui-command-capabilities.mjs --require-complete",
    "check:boundary": "node scripts/repository-boundary.mjs",
    "check": "bun run build:ts && bun run check:tui-runtime-binding && bun run check:tui-command-capabilities && bun run typecheck && bun run check:capabilities && bun run check:boundary",
    "format": "bunx biome check --write src tests scripts",
    "format:check": "bunx biome check src tests scripts",
    "ci": "bun run check && bun run test && bun run test:rust && bun run test:memory && bun run test:search && bun run test:account-bridge"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "^1.3.11",
    "bun-types": "^1.3.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "dependencies": {
    "@acosmi-ai/mcpb": "npm:@anthropic-ai/mcpb@2.1.2",
    "@acosmi/sdk-ts": "2.16.0",
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@alcalzone/jsonl-db": "^4.0.2",
    "@aws-sdk/client-bedrock": "^3.1024.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1024.0",
    "@aws-sdk/client-sts": "^3.1024.0",
    "@aws-sdk/credential-provider-node": "^3.972.29",
    "@azure/identity": "^4.13.1",
    "@commander-js/extra-typings": "13.1.0",
    "@growthbook/growthbook": "^1.6.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.218.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.218.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.218.0",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.218.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@smithy/core": "^3.23.13",
    "@smithy/node-http-handler": "^4.5.1",
    "ajv": "^8.18.0",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.14.0",
    "bidi-js": "^1.0.3",
    "bmp-js": "^0.1.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-boxes": "^4.0.1",
    "cli-highlight": "2.1.11",
    "code-excerpt": "^4.0.0",
    "commander": "13.1.0",
    "diff": "^8.0.4",
    "emoji-regex": "^10.6.0",
    "env-paths": "^4.0.0",
    "exceljs": "^4.4.0",
    "execa": "^9.6.1",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.3.0",
    "get-east-asian-width": "^1.5.0",
    "google-auth-library": "^10.6.2",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^9.0.0",
    "ignore": "^7.0.5",
    "indent-string": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.2.7",
    "marked": "^17.0.5",
    "p-map": "^7.0.4",
    "picomatch": "^4.0.4",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "semver": "^7.7.4",
    "sharp": "0.35.3",
    "shell-quote": "^1.8.3",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "tldts": "^7.0.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "type-fest": "^5.5.0",
    "undici": "^8.0.2",
    "urlpattern-polyfill": "^10.1.0",
    "utif2": "^4.1.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.20.0",
    "xss": "^1.0.15",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
